# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.r2.example

# herramienta local para pegar claves R2 (no versionar)
r2-setup.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# session notes
SESSION_NOTES.md

# local SII/debug artifacts
/.sii-explorer-profile/
/artifacts/*
!/artifacts/README.md
!/artifacts/signals/
!/artifacts/signals/*.md
!/artifacts/tasks/
!/artifacts/tasks/*.md
!/artifacts/docs/
!/artifacts/docs/*.md
!/artifacts/runs/
!/artifacts/runs/*.md
/*.xlsx
/~$*.xlsx
.vercel/token
.supabase/token
.git/.git-credentials-local

# Reporte del harness de tokenización (contiene glosas reales con PII)
artifacts/runs/tokenize-harness-report.json
