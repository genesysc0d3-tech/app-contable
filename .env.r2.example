# Cloudflare R2 — contrato de variables (SIN claves reales aquí).
# Las claves reales van en .env.local (gitignored). Usa r2-setup.html para
# generar el bloque y pegarlo en .env.local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=massdte-pdfs
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Opcional, solo si sirves PDFs públicos con dominio propio:
R2_PUBLIC_URL=
