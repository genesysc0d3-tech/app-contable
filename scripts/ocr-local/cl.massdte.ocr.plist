<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent del worker de OCR en el Mac mini.

  Instalar (en el mini, con TU usuario, NO sudo):
    cp cl.massdte.ocr.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/cl.massdte.ocr.plist

  Es LaunchAgent (no Daemon): corre como tu usuario, que es lo que necesita el
  framework Vision. KeepAlive lo reinicia si muere (o si el worker sale con
  código 1 al caerse la conexión). El secreto NO va acá: run-worker.sh lo toma
  de ~/.massdte-respaldo/config (el mismo del respaldo).

  Ajusta /Users/clau si el usuario del mini es otro.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cl.massdte.ocr</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/clau/massdte-ocr/run-worker.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/massdte-ocr.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/massdte-ocr.err.log</string>
</dict>
</plist>
