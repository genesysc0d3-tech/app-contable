# MassDTE backup config.
# Copy to ~/.massdte-backup/config.env  ->  then: chmod 600 ~/.massdte-backup/config.env
# NEVER commit this file. NEVER paste its contents anywhere.

# === Database (REQUIRED) ===
# Supabase -> Project Settings -> Database -> Connection string -> "Direct
# connection" (URI). Port 5432 (direct), NOT 6543 (pooler).
# Use a read-only role before real clients (see README section 7).
BACKUP_PGURL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# === Encryption (REQUIRED) ===
# Long random passphrase. STORE A COPY IN YOUR PASSWORD MANAGER.
# Lose it = backups unrecoverable. Leak it = backups exposed.
BACKUP_PASSPHRASE="cambia-esto-por-una-frase-larga-y-aleatoria"

# === Local storage ===
BACKUP_DIR="$HOME/massdte-backups"
KEEP_LOCAL=28          # 28 x 6h ~= 7 days of local copies
# BACKUP_PG_BIN="/opt/homebrew/opt/postgresql@17/bin/pg_dump"  # set if pg_dump 17 isn't first on PATH

# === Offsite copy: R2 / S3-compatible (recommended) ===
# Leave BUCKET/ENDPOINT empty to skip (then condition #1 is NOT met).
BACKUP_R2_BUCKET=""
BACKUP_R2_ENDPOINT=""                 # https://<accountid>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# === Alerts (enable at least one; healthchecks.io recommended) ===
BACKUP_HEALTHCHECK_URL=""             # https://hc-ping.com/<uuid>  (dead-man switch)
BACKUP_TG_TOKEN=""                    # optional Telegram bot token
BACKUP_TG_CHATID=""                   # optional Telegram chat id
BACKUP_TG_NOTIFY_OK=0                 # 1 = also ping Telegram on success
