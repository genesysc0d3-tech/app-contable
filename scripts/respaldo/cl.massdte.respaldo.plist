<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cl.massdte.respaldo</string>

  <!-- LaunchDaemon de SISTEMA (vive en /Library/LaunchDaemons/), NO LaunchAgent.
       Con `UserName` corre aunque nadie haya iniciado sesión: tras un corte de
       luz el mini arranca en la pantalla de login y IGUAL respalda. Un
       LaunchAgent en ~/Library/LaunchAgents/ NO correría hasta que alguien
       entre, y la alerta tampoco saltaría porque vive dentro del script que no
       corrió. Esta es la config REAL cargada en el mini (2026-09-05); el repo
       estaba desactualizado como Agent y se sincronizó. -->
  <key>UserName</key>
  <string>clau</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- `-c` sin `-l`: el script fija PGBIN y RCLONE con rutas absolutas, no
         necesita el PATH del login shell. Con `-l` se sourcea .zprofile/.bashrc
         de clau ANTES del script, y eso es superficie de ataque gratis (lo que
         llegue a ese perfil corre a las 3:30 con los secretos cargados). -->
    <string>-c</string>
    <string>/Users/clau/.massdte-respaldo/respaldar.sh</string>
  </array>

  <!-- 03:30 todos los días. Si el mini estaba apagado a esa hora, launchd lo
       corre apenas vuelve: un respaldo tarde es infinitamente mejor que ninguno. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/massdte-respaldo.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/massdte-respaldo.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
