<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cl.massdte.respaldo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/.massdte-respaldo/respaldar.sh</string>
  </array>

  <!-- 03:30 todos los días. Si el mini estaba apagado a esa hora, launchd lo
       corre apenas vuelve: un respaldo tarde es infinitamente mejor que ninguno. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/massdte-respaldo.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/massdte-respaldo.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
